{
	"manifest_version": 3,
	"name": "__MSG_extName__",
	"description": "__MSG_extDescription__",
	"default_locale": "en",
	"version": "1.0.1",
	"permissions": ["activeTab", "scripting", "storage", "tabs"],
	"host_permissions": ["<all_urls>"],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content_test.js"]
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["lib/*.js", "src/controller/*.js", "src/model/*.js", "_locales/*/messages.json"],
			"matches": ["<all_urls>"]
		}
	]
}
